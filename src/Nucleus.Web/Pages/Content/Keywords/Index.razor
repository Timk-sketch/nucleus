@page "/content/keywords"
@attribute [Authorize]
@layout ContentLayout
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Keyword Library — Content Hub</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Keyword Library</h1>
        <p class="page-subtitle">All tracked keywords — with live rank positions and content coverage counts.</p>
    </div>
</div>

@if (_brandsLoading)
{
    <div class="loading-state"><div class="spinner spinner--lg"></div></div>
}
else if (_brands.Count == 0)
{
    <div class="empty-state">
        No brands yet. <a href="/brands">Add a brand</a> to get started.
    </div>
}
else
{
    <!-- Brand Picker -->
    <div style="display:flex;gap:10px;margin-bottom:28px;flex-wrap:wrap;">
        @foreach (var b in _brands)
        {
            var isActive = _selectedBrand?.Id == b.Id;
            var btnStyle = "padding:8px 16px;border-radius:999px;border:2px solid " +
                (isActive ? "#3b82f6" : "var(--color-border)") + ";background:" +
                (isActive ? "rgba(59,130,246,0.1)" : "var(--color-surface)") + ";color:" +
                (isActive ? "#3b82f6" : "var(--color-text)") +
                ";font-size:13px;font-weight:600;cursor:pointer;";
            <button @onclick="() => SelectBrand(b)" style="@btnStyle">@b.Name</button>
        }
    </div>

    @if (_selectedBrand != null)
    {
        <!-- Stats bar -->
        <div style="display:flex;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
            <div class="stat-card" style="flex:1;min-width:140px;">
                <div class="stat-value">@(_library?.TotalKeywords ?? 0)</div>
                <div class="stat-label">Total Keywords</div>
            </div>
            <div class="stat-card" style="flex:1;min-width:140px;">
                <div class="stat-value">@(_library?.Keywords.Count(k => k.LatestPosition.HasValue) ?? 0)</div>
                <div class="stat-label">With Rankings</div>
            </div>
            <div class="stat-card" style="flex:1;min-width:140px;">
                <div class="stat-value">@(_library?.Keywords.Sum(k => k.ContentCount) ?? 0)</div>
                <div class="stat-label">Content Pages</div>
            </div>
            <div class="stat-card" style="flex:1;min-width:140px;">
                <div class="stat-value">@(_library?.Keywords.Count(k => k.ContentCount == 0) ?? 0)</div>
                <div class="stat-label">No Content Yet</div>
            </div>
        </div>

        <!-- Toast message -->
        @if (!string.IsNullOrEmpty(_toast))
        {
            <div style="margin-bottom:16px;padding:10px 16px;border-radius:var(--radius);background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);color:#059669;font-size:13px;font-weight:600;">
                @_toast
            </div>
        }

        <!-- Search + Actions -->
        <div style="display:flex;gap:12px;margin-bottom:@(_showAdd || _showBulk ? "12px" : "20px");align-items:center;flex-wrap:wrap;">
            <input class="form-input" @bind="_search" @bind:event="oninput"
                   placeholder="Search keywords…"
                   style="max-width:280px;flex:1;" />
            <button class="btn-secondary" style="font-size:13px;white-space:nowrap;"
                    @onclick="ToggleBulk" disabled="@_working">
                Bulk Import
            </button>
            <button class="btn-secondary" style="font-size:13px;white-space:nowrap;"
                    @onclick="CheckRankings" disabled="@(_working || _checkingRanks)">
                @(_checkingRanks ? "Queued…" : "Check Rankings")
            </button>
            <button class="btn-secondary" style="font-size:13px;white-space:nowrap;background:rgba(59,130,246,0.08);border-color:#3b82f6;color:#3b82f6;"
                    @onclick="ToggleAdd" disabled="@_working">
                @(_showAdd ? "Cancel" : "+ Add Keyword")
            </button>
            <button class="btn-primary" style="font-size:13px;"
                    @onclick="NavigateToGenerator">
                + Generate Content
            </button>
        </div>

        <!-- Add keyword form -->
        @if (_showAdd)
        {
            <div style="background:var(--color-surface);border:1px solid #3b82f6;border-radius:var(--radius);padding:16px 20px;margin-bottom:20px;display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
                <div style="flex:2;min-width:200px;">
                    <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--color-muted);display:block;margin-bottom:4px;">Keyword</label>
                    <input class="form-input" @bind="_newKeyword" placeholder="e.g. car registration online"
                           style="width:100%;" @onkeyup="AddKeywordOnEnter" />
                </div>
                <div style="flex:2;min-width:180px;">
                    <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--color-muted);display:block;margin-bottom:4px;">Target URL <span style="font-weight:400;">(optional)</span></label>
                    <input class="form-input" @bind="_newTargetUrl" placeholder="https://…"
                           style="width:100%;" />
                </div>
                <button class="btn-primary" style="font-size:13px;flex-shrink:0;"
                        @onclick="AddKeyword" disabled="@(_working || string.IsNullOrWhiteSpace(_newKeyword))">
                    @(_working ? "Adding…" : "Add")
                </button>
            </div>
        }

        <!-- Bulk import form -->
        @if (_showBulk)
        {
            <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:16px 20px;margin-bottom:20px;">
                <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--color-muted);display:block;margin-bottom:8px;">
                    Paste keywords — one per line or comma-separated
                </label>
                <textarea class="form-input" @bind="_bulkText"
                          rows="5" placeholder="car registration online&#10;motorcycle title transfer&#10;dmv services near me"
                          style="width:100%;font-family:monospace;font-size:13px;resize:vertical;"></textarea>
                <div style="display:flex;gap:8px;margin-top:10px;justify-content:flex-end;">
                    <button class="btn-secondary" style="font-size:13px;" @onclick="CancelBulk">
                        Cancel
                    </button>
                    <button class="btn-primary" style="font-size:13px;"
                            @onclick="BulkImport" disabled="@(_working || string.IsNullOrWhiteSpace(_bulkText))">
                        @(_working ? "Importing…" : "Import Keywords")
                    </button>
                </div>
            </div>
        }

        @if (_loading)
        {
            <div class="loading-state"><div class="spinner spinner--lg"></div></div>
        }
        else if (_library?.Keywords.Count == 0)
        {
            <div class="empty-state">
                No keywords tracked yet. Use "+ Add Keyword" above or paste a bulk list to get started.
            </div>
        }
        else
        {
            <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden;">
                <table style="width:100%;border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--color-border);background:rgba(0,0,0,0.02);">
                            <th class="table-th">Keyword</th>
                            <th class="table-th">Position</th>
                            <th class="table-th">Content</th>
                            <th class="table-th">Target URL</th>
                            <th class="table-th">Last Checked</th>
                            <th class="table-th"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kw in FilteredKeywords())
                        {
                            var delta = kw.LatestPosition.HasValue && kw.PreviousPosition.HasValue
                                ? kw.PreviousPosition.Value - kw.LatestPosition.Value : (int?)null;
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 20px;font-weight:600;">@kw.Keyword</td>
                                <td style="padding:14px 20px;">
                                    @if (kw.LatestPosition.HasValue)
                                    {
                                        <span style="font-weight:700;font-size:15px;">#@kw.LatestPosition</span>
                                        @if (delta.HasValue && delta.Value != 0)
                                        {
                                            var dStyle = delta.Value > 0
                                                ? "margin-left:6px;font-size:11px;font-weight:700;color:#10b981;"
                                                : "margin-left:6px;font-size:11px;font-weight:700;color:#ef4444;";
                                            <span style="@dStyle">
                                                @(delta.Value > 0 ? "▲" : "▼")@Math.Abs(delta.Value)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:var(--color-muted);">—</span>
                                    }
                                </td>
                                <td style="padding:14px 20px;">
                                    @if (kw.ContentCount > 0)
                                    {
                                        <span style="padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;background:rgba(59,130,246,0.1);color:#3b82f6;">
                                            @kw.ContentCount page@(kw.ContentCount != 1 ? "s" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;color:var(--color-muted);">none</span>
                                    }
                                </td>
                                <td style="padding:14px 20px;font-size:13px;color:var(--color-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                    @if (!string.IsNullOrEmpty(kw.TargetUrl))
                                    {
                                        <a href="@kw.TargetUrl" target="_blank" rel="noopener"
                                           style="color:#3b82f6;">@kw.TargetUrl</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="padding:14px 20px;font-size:13px;color:var(--color-muted);">
                                    @(kw.LastCheckedAt.HasValue ? kw.LastCheckedAt.Value.ToString("MMM d") : "—")
                                </td>
                                <td style="padding:14px 20px;text-align:right;white-space:nowrap;">
                                    <button @onclick="() => GenerateForKeyword(kw)"
                                            style="font-size:12px;color:#3b82f6;background:none;border:none;cursor:pointer;margin-right:12px;">
                                        Generate →
                                    </button>
                                    <button @onclick="() => DeleteKeyword(kw.Id)"
                                            disabled="@_working"
                                            title="Delete keyword"
                                            style="font-size:13px;color:var(--color-muted);background:none;border:none;cursor:pointer;line-height:1;padding:2px 4px;border-radius:4px;"
                                            onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='var(--color-muted)'">
                                        ✕
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private List<BrandItem> _brands = [];
    private BrandItem? _selectedBrand;
    private bool _brandsLoading = true, _loading;
    private string _search = "";
    private KeywordLibraryDto? _library;

    // Add keyword form
    private bool _showAdd;
    private string _newKeyword = "";
    private string _newTargetUrl = "";

    // Bulk import
    private bool _showBulk;
    private string _bulkText = "";

    // Status
    private bool _working;
    private bool _checkingRanks;
    private string _toast = "";

    protected override async Task OnInitializedAsync()
    {
        var resp = await Http.GetFromJsonAsync<ApiWrap<List<BrandItem>>>("api/v1/brands");
        _brands = resp?.Data ?? [];
        _brandsLoading = false;
        if (_brands.Count > 0) await SelectBrand(_brands[0]);
    }

    private async Task SelectBrand(BrandItem brand)
    {
        _selectedBrand = brand;
        _search = "";
        _showAdd = false;
        _showBulk = false;
        await LoadLibrary();
    }

    private async Task LoadLibrary()
    {
        if (_selectedBrand is null) return;
        _loading = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiWrap<KeywordLibraryDto>>(
                $"api/content/keywords?brandId={_selectedBrand.Id}&pageSize=200");
            _library = resp?.Data;
        }
        catch { }
        finally { _loading = false; }
    }

    private void ToggleAdd()
    {
        _showAdd = !_showAdd;
        if (_showAdd) _showBulk = false;
        _newKeyword = "";
        _newTargetUrl = "";
    }

    private void ToggleBulk()
    {
        _showBulk = !_showBulk;
        if (_showBulk) _showAdd = false;
        _bulkText = "";
    }

    private void CancelBulk()
    {
        _showBulk = false;
        _bulkText = "";
    }

    private async Task AddKeywordOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newKeyword))
            await AddKeyword();
    }

    private async Task AddKeyword()
    {
        if (_selectedBrand is null || string.IsNullOrWhiteSpace(_newKeyword)) return;
        _working = true;
        _toast = "";
        try
        {
            var req = new { keyword = _newKeyword.Trim(), targetUrl = string.IsNullOrWhiteSpace(_newTargetUrl) ? null : _newTargetUrl.Trim() };
            var resp = await Http.PostAsJsonAsync($"api/v1/brands/{_selectedBrand.Id}/keywords", req);
            if (resp.IsSuccessStatusCode)
            {
                _newKeyword = "";
                _newTargetUrl = "";
                _showAdd = false;
                await LoadLibrary();
                ShowToast("Keyword added.");
            }
        }
        catch { }
        finally { _working = false; }
    }

    private async Task BulkImport()
    {
        if (_selectedBrand is null || string.IsNullOrWhiteSpace(_bulkText)) return;
        _working = true;
        _toast = "";
        try
        {
            var lines = _bulkText
                .Split(['\n', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var added = 0;
            foreach (var kw in lines)
            {
                var req = new { keyword = kw };
                var resp = await Http.PostAsJsonAsync($"api/v1/brands/{_selectedBrand.Id}/keywords", req);
                if (resp.IsSuccessStatusCode) added++;
            }

            _showBulk = false;
            _bulkText = "";
            await LoadLibrary();
            ShowToast($"{added} keyword{(added != 1 ? "s" : "")} imported.");
        }
        catch { }
        finally { _working = false; }
    }

    private async Task DeleteKeyword(Guid keywordId)
    {
        if (_selectedBrand is null) return;
        _working = true;
        _toast = "";
        try
        {
            var resp = await Http.DeleteAsync($"api/v1/brands/{_selectedBrand.Id}/keywords/{keywordId}");
            if (resp.IsSuccessStatusCode)
            {
                await LoadLibrary();
                ShowToast("Keyword removed.");
            }
        }
        catch { }
        finally { _working = false; }
    }

    private async Task CheckRankings()
    {
        if (_selectedBrand is null) return;
        _checkingRanks = true;
        _toast = "";
        try
        {
            var resp = await Http.PostAsync($"api/v1/brands/{_selectedBrand.Id}/keywords/ranks/check", null);
            if (resp.IsSuccessStatusCode)
                ShowToast("Rank check queued — results will appear within a few minutes.");
        }
        catch { }
        finally { _checkingRanks = false; }
    }

    private void ShowToast(string msg)
    {
        _toast = msg;
        _ = ClearToastAfterDelay();
    }

    private async Task ClearToastAfterDelay()
    {
        await Task.Delay(4000);
        _toast = "";
        StateHasChanged();
    }

    private IEnumerable<KeywordItemDto> FilteredKeywords()
    {
        var kws = _library?.Keywords ?? [];
        if (!string.IsNullOrWhiteSpace(_search))
            kws = kws.Where(k => k.Keyword.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        return kws;
    }

    private void NavigateToGenerator()
    {
        if (_selectedBrand is null) return;
        Nav.NavigateTo("/content/generator?brandId=" + _selectedBrand.Id);
    }

    private void GenerateForKeyword(KeywordItemDto kw)
    {
        Nav.NavigateTo("/content/generator?brandId=" + _selectedBrand!.Id +
            "&keywordId=" + kw.Id + "&keyword=" + Uri.EscapeDataString(kw.Keyword));
    }

    // ── DTOs ──
    private class BrandItem { public Guid Id { get; set; } public string Name { get; set; } = ""; }

    private class KeywordLibraryDto
    {
        public Guid BrandId { get; set; }
        public string BrandName { get; set; } = "";
        public int TotalKeywords { get; set; }
        public List<KeywordItemDto> Keywords { get; set; } = [];
    }

    private class KeywordItemDto
    {
        public Guid Id { get; set; }
        public string Keyword { get; set; } = "";
        public string? TargetUrl { get; set; }
        public int? LatestPosition { get; set; }
        public int? PreviousPosition { get; set; }
        public DateTimeOffset? LastCheckedAt { get; set; }
        public int ContentCount { get; set; }
    }

    private record ApiWrap<T>(bool Success, T? Data);
}
